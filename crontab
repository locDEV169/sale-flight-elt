# Install on VPS (example):
#   crontab -e
# Paste below after setting absolute paths and ensuring .env + SA are ready.
# TZ must be Asia/Ho_Chi_Minh (08:00 and 20:00 ICT).

SHELL=/bin/bash
TZ=Asia/Ho_Chi_Minh
PATH=/usr/local/bin:/usr/bin:/bin

0 8,20 * * * cd /opt/sale-flight && /opt/sale-flight/.venv/bin/python main.py >> /var/log/sale-flight.log 2>&1
